{
    "name": "@phil/ux-css",
    "description": "phil-ux, the CSS framework of PHIL: real, mostly classless CSS with --phil-* tokens, light and dark, and isX/hasX state classes",
    "version": "0.1.0",
    "license": "MIT",
    "homepage": "https://ph-il.ca",
    "repository": {
        "type": "git",
        "url": "https://github.com/parler-haut-interagir-librement/ux-css.git"
    },
    "keywords": [
        "css",
        "design-system",
        "design-tokens",
        "oklch",
        "dark-mode",
        "accessibility"
    ],
    "style": "dist/phil-ux.css",
    "main": "dist/phil-ux.css",
    "exports": {
        ".": "./dist/phil-ux.css",
        "./tokens.json": "./dist/tokens.json",
        "./dist/*": "./dist/*",
        "./css/*": "./css/*"
    },
    "files": [
        "css/",
        "dist/",
        "LICENSE",
        "README.md"
    ],
    "sideEffects": [
        "*.css"
    ]
}
